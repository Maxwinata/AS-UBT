APP_NAME="Portal SI-GABUNG 54"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://asrama-ubt.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asrama_ubt_db
DB_USERNAME=root
DB_PASSWORD=

# KONEKSI DATABASE SIMABA (PENDAFTARAN MAHASISWA BARU - DUAL DATABASE)
# CATATAN KEAMANAN: Masukkan password asli basis data SIMABA HANYA pada file .env privat di server Anda.
# JANGAN PERNAH menyimpan kredensial server riil pada file template .env.example yang dikomit ke GitHub!
DB_SIMABA_CONNECTION=mysql
DB_SIMABA_HOST=127.0.0.1
DB_SIMABA_PORT=3306
DB_SIMABA_DATABASE=u540633926_simaba
DB_SIMABA_USERNAME=u540633926_simaba
DB_SIMABA_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=639

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ubtsu.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# PRIVATE STORAGE STRATEGY UNTUK DOKUMEN KYC (KTP & SELFIE BIOMETRIK)
KYC_STORAGE_DISK=private_kyc
KYC_RETENTION_DAYS=60
KYC_SIGNED_URL_TTL_MINUTES=15

# WHATSAPP GATEWAY (UNTUK OTP KONTRAK & NOTIFIKASI TIKET)
WA_GATEWAY_PROVIDER=fonnte
WA_GATEWAY_URL=https://api.fonnte.com/send
WA_GATEWAY_TOKEN=your_token_here

# ACUAN TARIF DEFAULT
TARIF_ADMINISTRASI=100000
TARIF_SEWA_STANDAR=500000

# ==============================================================================
# CLEAN UI / TESTING MODE (UAT & QA ENVIRONMENT ONLY)
# ==============================================================================
# Gunakan konfigurasi ini pada environment staging/testing untuk menyederhanakan
# antarmuka dan fokus pada alur bisnis utama tanpa gangguan banner promosi & dev tools.
#
# Pilihan APP_UI_MODE:
# - 'standard' : Tampilan penuh normal dengan widget dev tools, persona switcher, dan demo buttons.
# - 'clean'    : Mode pengujian minimal (MinimalTestingLayout, sembunyikan kredensial publik, form bersih).
APP_UI_MODE=standard
TEST_MODE=false

# Flag client-side untuk Vite (Frontend SPA / Inertia Client)
VITE_APP_UI_MODE=standard
VITE_TEST_MODE=false
